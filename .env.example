# Neo4j Aura — system of record
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Nosana — embedding inference on GPU
NOSANA_API_KEY=
NOSANA_API_URL=https://api.nosana.com/api
NOSANA_MARKET=RXP7JK8MTY4uPJng4UjC9ZJdDDSG6wGr8pvVf3mwgXF
NOSANA_ENDPOINT=

# Daytona — sandboxed execution
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Tuning
EMBEDDING_DIMENSIONS=768
REMOTE_TIMEOUT_MS=3000

# Daytona sandbox create plus run, for the write path. Measured: create alone
# 0.9 to 6.3s, create plus run p50 ~2.2s with a worst case near 8s.
DAYTONA_TIMEOUT_MS=15000

# analyze runs generated Cypher in a sandbox and has no fallback, so it waits
# longer than the write path, which degrades in process. Measured 3.4 to 5.0s
# typical with a 13.4s outlier, because domainAllowList adds proxy setup.
ANALYZE_TIMEOUT_MS=30000

# --- agent-ui chat backend only. The MCP server does not read these, which is
# --- why they are validated in agent-ui/server rather than in src/config.ts.
# OpenAI-compatible base URL for the chat model. Written by `npm run deploy:chat`.
# Leave empty and the chat UI still runs, reporting the model as unavailable.
NOSANA_CHAT_ENDPOINT=
# Served model name on that endpoint.
NOSANA_CHAT_MODEL=chat
# Port for the chat backend process.
MNEMEX_UI_PORT=8787
# How long to wait for the chat endpoint to accept a connection.
MNEMEX_CHAT_CONNECT_TIMEOUT_MS=30000
